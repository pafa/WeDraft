{
  "name": "wedraft",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @wedraft/desktop tauri:dev",
    "dev:desktop": "pnpm --filter @wedraft/desktop tauri:dev",
    "dev:web": "pnpm --filter @wedraft/web dev",
    "dev:desktop-web": "pnpm --filter @wedraft/desktop dev",
    "build:web": "pnpm --filter @wedraft/web build",
    "build:tools": "pnpm --filter @wedraft/cli build && pnpm --filter @wedraft/mcp build",
    "smoke:web": "node scripts/smoke-web.mjs",
    "cli": "tsx packages/cli/src/cli.ts",
    "mcp": "tsx packages/mcp/src/server.ts",
    "build": "pnpm -r --if-present build",
    "build:mac": "pnpm --filter @wedraft/desktop tauri:build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "0.28.1",
    "playwright": "1.58.2",
    "tsx": "4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
