{
  "name": "wedraft",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @wedraft/desktop tauri:dev",
    "dev:desktop": "pnpm --filter @wedraft/desktop tauri:dev",
    "dev:web": "pnpm --filter @wedraft/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:mac": "pnpm --filter @wedraft/desktop tauri:build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
