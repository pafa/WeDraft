#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
repo=pafa/WeDraft
origin="$(git remote get-url origin)"
case "$origin" in
  https://github.com/pafa/WeDraft.git|https://github.com/pafa/WeDraft|git@github.com:pafa/WeDraft.git) ;;
  *) echo "origin 与 pafa/WeDraft 不匹配；停止。" >&2; exit 1 ;;
esac
[[ "$(gh api "repos/$repo" --jq .private)" == true ]] || {
  echo "目标必须是私有仓库；停止。" >&2; exit 1;
}
gh api "repos/$repo" --method PATCH \
  -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false \
  -F allow_auto_merge=false -F delete_branch_on_merge=true \
  -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=PR_BODY >/dev/null
gh api "repos/$repo/actions/permissions/workflow" --method PUT \
  -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null
# Fail visibly on unsupported plans; never make the repository public or bypass protection.
gh api "repos/$repo/branches/main/protection" --method PUT \
  --input .github/main-protection.json >/dev/null
rule_id="$(gh api "repos/$repo/rulesets" --paginate --jq '.[] | select(.name == "Immutable release tags") | .id')"
if [[ -n "$rule_id" ]]; then
  gh api "repos/$repo/rulesets/$rule_id" --method PUT --input .github/tag-protection.json >/dev/null
else
  gh api "repos/$repo/rulesets" --method POST --input .github/tag-protection.json >/dev/null
fi
gh api "repos/$repo/branches/main/protection" \
  --jq '{checks: .required_status_checks, admins: .enforce_admins.enabled, pr: .required_pull_request_reviews, force: .allow_force_pushes.enabled, deletion: .allow_deletions.enabled, conversations: .required_conversation_resolution.enabled}'
gh api "repos/$repo/rulesets" --jq '.[] | {name,target,enforcement}'
